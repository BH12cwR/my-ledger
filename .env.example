# 本地 `next dev`：@opennextjs/cloudflare 的 initOpenNextCloudflareForDev() 会把
# wrangler.toml 中的 [[d1_databases]] 绑定注入到 Next 开发服务器，
# 配置密钥请写在 .dev.vars（见 .dev.vars.example）。
#
# 生产环境（Cloudflare Workers）的机密通过以下命令配置：
#   wrangler secret put AUTH_JWT_SECRET
# 非机密变量写在 wrangler.toml 的 [vars] 中。

# 微信 OAuth 回调地址前缀（生产环境必须是已备案并加入到微信开放平台的域名）
WECHAT_OAUTH_REDIRECT_BASE=http://localhost:3000

# 生产环境必须为 false
AUTH_DEV_MODE=false

# 管理员口令 PBKDF2 迭代次数
ADMIN_PBKDF2_ITERATIONS=20000